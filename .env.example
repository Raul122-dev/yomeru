# yomeru — copy to .env (setup.sh does it for you)
# everything else is configured from the Settings page

# port (default 7788)
# PORT=7788

# bind address (default 127.0.0.1 — local only)
# HOST=127.0.0.1

# data directory — runs, config.json, downloaded model weights
# default: ./data when running from the repo, ~/.yomeru when pip-installed
# YOMERU_DATA=/custom/path
